{
  "headers": [
    {
      "source": "/sentences/*.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "caches": [
    {
      "source": "/sentences/*.json",
      "cacheTtl": 86400
    }
  ]
}
